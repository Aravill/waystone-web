# Waystone Web Application - Environment Variables

# Server Configuration (optional, defaults to 8080)
PORT=8080

# Admin account
# The admin is created/reset from these values on every startup.
# The password cannot be changed in the app; change it here and restart.
# ADMIN_USERNAME: optional, defaults to "admin" (2-32 chars: a-z, 0-9, _ or -).
# ADMIN_PASSWORD: REQUIRED - without it the admin can't log in.
# NOTE: docker-compose interpolates "$", so write every "$" in the password as "$$".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Session Secret (REQUIRED in production; an insecure default is used if unset)
# Used to sign session cookies. Change this to a random string in production.
# Generate a secure value: openssl rand -base64 32
SESSION_SECRET=change-me-to-random-secret-in-production
