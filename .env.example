# Waystone Web Application - Environment Variables

# Server Configuration (optional, defaults to 8080)
PORT=8080

# Admin account
# The admin is created/reset from these values on every startup.
# The password cannot be changed in the app; change it here and restart.
# ADMIN_USERNAME: optional, defaults to "admin" (2-32 chars: a-z, 0-9, _ or -).
# ADMIN_PASSWORD: REQUIRED - without it the admin can't log in.
# NOTE: docker-compose interpolates "$", so write every "$" in the password as "$$".
# Use at least 10 characters (a WARNING is logged otherwise). Max 72 bytes (bcrypt limit):
# the server refuses to start with a longer one. User-chosen passwords must also mix
# upper/lowercase letters and digits; that rule is not enforced for ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Session Secret: REQUIRED, at least 32 characters. The server refuses to start without it.
# Used to sign session cookies; anyone who knows it can forge logins.
# Generate a secure value: openssl rand -base64 32
# NOTE: write every "$" as "$$" (docker-compose interpolation); base64 output has none.
SESSION_SECRET=

# Trust proxy: optional, default off. Set to 1/true only when the app is reachable
# solely through a reverse proxy that appends X-Forwarded-For (e.g. Caddy).
# Login rate limits then use the client IP from X-Forwarded-For; otherwise clients
# could forge it, so leave it unset if the port is directly reachable.
TRUST_PROXY=
